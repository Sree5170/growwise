# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/growwise
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
# Set true when frontend and API are on different sites over HTTPS
COOKIE_CROSS_SITE=false

# Optional: fixed password for fictional demo accounts created by `npm run seed`
SEED_DEMO_PASSWORD=Demo-Passw0rd-2026
